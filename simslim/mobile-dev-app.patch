+  @discardableResult
+  func loadMobileDevProfile() -> Bool {
+    struct Profile: Decodable {
+      let except: [String]
+      let keep: [String]
+    }
+
+    do {
+      let profile = try JSONDecoder().decode(
+        Profile.self, from: Data(contentsOf: mobileDevProfileURL))
+      let categoryIDs = Set(profile.except)
+      let serviceLabels = Set(profile.keep)
+      guard !categories.isEmpty,
+        categoryIDs.isSubset(of: Set(categories.map(\.id))),
+        serviceLabels.isSubset(of: Set(categories.flatMap(\.labels)))
+      else {
+        throw NSError(
+          domain: "SimSlim", code: 1,
+          userInfo: [NSLocalizedDescriptionKey: "Mobile Dev profile contains unknown categories or services."])
+      }
+      keptCategoryIDs = categoryIDs
+      keptServiceLabels = serviceLabels
+      record(.info, "Selected Mobile Dev profile: \(disabledDaemonCount) services to disable")
+      return true
+    } catch {
+      recordFailure("Could not load Mobile Dev profile: \(error.localizedDescription)", present: true)
+      return false
+    }
   }

